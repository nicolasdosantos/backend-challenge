# Valores padrão para desenvolvimento local com o docker-compose.yml (não são segredos de produção).
PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_PREFIX=
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=6
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_BATCH_SIZE=5
SQS_CONSUMER_WAIT_TIME_SECONDS=10
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_RETRY_BASE_DELAY_SECONDS=2
SQS_CONSUMER_RETRY_MAX_DELAY_SECONDS=60
# Deve ser igual ao maxReceiveCount da redrive policy da fila (scripts/create-queues.ts)
SQS_CONSUMER_MAX_RECEIVE_COUNT=5
SQS_CONSUMER_SHUTDOWN_TIMEOUT_MS=10000
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
# Recurso de teste: encerra o processo após o commit e antes do ack. Nunca definir em produção.
FAULT_CRASH_AFTER_COMMIT=
