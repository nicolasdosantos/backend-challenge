# Valores padrão para desenvolvimento local com o docker-compose.yml (não são segredos de produção).
PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_PREFIX=
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=6
