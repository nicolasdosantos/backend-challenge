{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migration:create": "bun --bun mikro-orm migration:create",
    "migration:up": "bun --bun mikro-orm migration:up",
    "migration:down": "bun --bun mikro-orm migration:down",
    "migration:list": "bun --bun mikro-orm migration:list",
    "sqs:create-queues": "bun run scripts/create-queues.ts"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1149.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  }
}
